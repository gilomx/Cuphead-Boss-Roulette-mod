<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NuGetAudit>false</NuGetAudit>
    <!-- Production protocol fields are intentionally not all populated by
         this focused harness. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <!-- The unusual .cs.txt suffix keeps the SDK-style mod project from
       discovering the harness fakes through its recursive *.cs glob. -->
  <ItemGroup>
    <Compile Include="Program.cs.txt" Link="Program.cs" />
    <Compile Include="MiniBossSpawnPolicyTests.cs.txt" Link="MiniBossSpawnPolicyTests.cs" />
    <Compile Include="DonorLabelLifetimeTests.cs.txt" Link="DonorLabelLifetimeTests.cs" />
    <Compile Include="PeskyModeSettingsTests.cs.txt" Link="PeskyModeSettingsTests.cs" />
    <Compile Include="RuntimeStubs.cs.txt" Link="RuntimeStubs.cs" />

    <Compile Include="..\Interactions\CreatorToolsMiniBossSpawnPolicy.cs"
             Link="Product\Interactions\CreatorToolsMiniBossSpawnPolicy.cs" />
    <Compile Include="..\Interactions\CreatorToolsDonorLabelLifetime.cs"
             Link="Product\Interactions\CreatorToolsDonorLabelLifetime.cs" />
    <Compile Include="..\Interactions\CreatorToolsPeskyModeSettings.cs"
             Link="Product\Interactions\CreatorToolsPeskyModeSettings.cs" />

    <Compile Include="..\CreatorToolsDashboardController.cs"
             Link="Product\CreatorToolsDashboardController.cs" />
    <Compile Include="..\CreatorToolsServer.cs"
             Link="Product\CreatorToolsServer.cs" />
    <Compile Include="..\CreatorToolsOverlayComposerController.cs"
             Link="Product\CreatorToolsOverlayComposerController.cs" />
    <Compile Include="..\CreatorToolsOverlayComposerSettings.cs"
             Link="Product\CreatorToolsOverlayComposerSettings.cs" />
    <Compile Include="..\CreatorToolsTapFarmingSettings.cs"
