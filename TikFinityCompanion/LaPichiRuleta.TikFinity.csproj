<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LaPichiRuleta.TikFinity</AssemblyName>
    <RootNamespace>LaPichiRuleta.TikFinity</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="All" />
    <Protobuf Include="YouTube\stream_list.proto" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\youtube-oauth.local.json')">
    <EmbeddedResource Include="..\youtube-oauth.local.json" LogicalName="LaPichiRuleta.YouTube.DesktopClient.json" />
  </ItemGroup>
</Project>
